.op-page
  .op-page__sidebar
    = render "sidebar"
    
  .op-page__main
    main.op-page__main-content
      header.content-header
        .content-header__details
          h1.content-header__title
            = @game.name

      .card
        .flex.flex-col.card__body
          span = "Type: #{@game.game_type.titleize}"
          br
          span = "Created at: #{@game.created_at.strftime("%m/%d/%y at %I:%M %p")}"
          br
          span = "Status: #{@game.status}"