doctype html
html
  head = render 'head'
  body data-controller='service-worker' data-service-worker-url-value=pwa_service_worker_path
    = turbo_frame_tag 'modal'
    = tag.div(flash[:alert], style: "color:red") if flash[:alert]
    = tag.div(flash[:notice], style: "color:green") if flash[:notice]
    = yield