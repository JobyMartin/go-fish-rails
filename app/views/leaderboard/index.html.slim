.op-page
  .op-page__sidebar
    = render "sidebar"

  .op-page__main
    main.op-page__main-content
      header.content-header
        .content-header__details
          h1.content-header__title
            | Leaderboard

      table.table.table--container.table--odd-striped
        thead
          tr
            th Rank
            th Player
            th Games played
            th Wins
            th Win %
            th Time played
        tbody
          - @entries.each_with_index do |entry, index|
            tr
              td = index + 1
              td = entry.username
              td = entry.games_played
              td = entry.games_won
              td = win_percentage_for(entry)
              td = time_played_for(entry)
