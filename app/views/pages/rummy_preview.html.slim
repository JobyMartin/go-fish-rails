- melds = [%w[7_spades 8_spades 9_spades], %w[q_hearts q_diamonds q_clubs], %w[3_hearts 4_hearts 5_hearts 6_hearts], %w[9_spades 9_diamonds 9_hearts 9_clubs], %w[10_spades j_spades q_spades k_spades], %w[10_hearts j_hearts q_hearts], %w[k_spades k_hearts k_diamonds k_clubs]]
- hand = [{ card: '3_hearts', selected: true }, { card: '4_hearts', selected: true }, { card: '5_hearts', selected: true }, { card: '6_hearts', selected: false }, { card: '9_spades', selected: false }, { card: '9_diamonds', selected: false }, { card: '2_clubs', selected: false }, { card: 'k_spades', selected: false }]
- players = [{ name: 'You', turn: true, card_count: 8 }, { name: 'Josh', turn: false, card_count: 5 }]
- feed_lines = ['Josh discarded K of Clubs', 'Josh melded 7♠ 8♠ 9♠', 'Josh laid off Q♦ onto your set', 'You drew from the stock', "It's your turn — draw a card"]

.game
  .game__players.panel.panel--players
    .panel__header
      span.flex.items-center.gap-xs
        = link_to games_path, class: 'btn btn--medium' do
          i.ph.ph-arrow-left.icon
        | Rummy · "Rummy Mock"

    .panel__content
      .op-stack
        span The Table

        .melds
          - melds.each do |cards|
            .meld
              .flex
                - cards.each do |card|
                  = image_tag "generated_cards/#{card}.svg", class: 'playing-card playing-card--small'
              button.btn.btn--medium.meld__layoff Lay off here

  .game__feed.panel.panel--feed
    .panel__header
      span Draw a card
      .badge Your Turn

    .panel__content
      .rummy-turn
        .rummy-turn__piles
          .pile
            = image_tag 'generated_cards/card_back_green.svg', class: 'playing-card playing-card--medium playing-card--flush-border'
            span Deck (47)
          .pile
            = image_tag 'generated_cards/k_clubs.svg', class: 'playing-card playing-card--medium playing-card--flush-border'
            span Discard

        .turn-actions
          button.btn.btn--primary Draw deck
          button.btn Take discard
          button.btn disabled=true Meld selected
          button.btn disabled=true Discard selected

  .game__hand.panel.panel--hand
    .panel__header
      | Your Hand

    .panel__content
      .flex.hand
        - hand.each do |entry|
          - classes = ['playing-card playing-card--large playing-card--selectable', ('is-selected' if entry[:selected])].compact.join(' ')
          = image_tag "generated_cards/#{entry[:card]}.svg", class: classes

  .game__books.panel.panel--books
    .panel__header
      | Players

    .panel__content
      .op-stack
        - players.each do |player|
          .player-row
            span.flex.items-center.gap-xs
              = player[:name]
              - if player[:turn]
                .badge turn
            span= "#{player[:card_count]} cards"

button.feed-tab
  | Game Feed
  span.feed-tab__dot aria-hidden="true"

.feed-backdrop

aside.feed-drawer
  .panel__header
    span Game Feed
  .feed-content
    - feed_lines.each do |line|
      span.feed-content__player-action = line
