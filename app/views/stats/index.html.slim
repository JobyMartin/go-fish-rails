.op-page
  .op-page__sidebar
    = render "sidebar"

  .op-page__main
    main.op-page__main-content
      header.content-header
        .content-header__details
          h1.content-header__title
            | Your Go Fish Statistics

      .flex.flex-wrap.gap-md
        = render 'stat-card', header: 'Games played', body: @user.games.count
        = render 'stat-card', header: 'Games won', body: @games_won
        = render 'stat-card', header: 'Win percentage', body: @win_percentage