
.op-page
  .op-page__sidebar
    = render "sidebar"
  
  .op-page__main
    main.op-page__main-content
      header.content-header
        .content-header__details
          h1.content-header__title
            | Your profile

      / .divider
      
      = Current.user.email_address
       / = Current.user.created_at

      = button_to 'Edit profile', edit_user_path(Current.user.id), method: :get, class: 'btn btn--primary'